# Copy to .env (git-ignored) for local development.
# On Vercel, add these under Project → Settings → Environment Variables instead.

# Neon connection string (Neon dashboard → Connect). The pooled ("-pooler") one is best.
DATABASE_URL=

# Password for the /admin dashboard
ADMIN_PASSWORD=

# Optional: any long random string. Defaults to one derived from ADMIN_PASSWORD.
SESSION_SECRET=
