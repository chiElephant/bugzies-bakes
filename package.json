{
  "name": "bugzies-bakes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "vite": "^6.4.4"
  }
}
